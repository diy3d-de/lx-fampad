<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- App-Updates vom eigenen Update-Kanal per PackageInstaller installieren (Android fragt einmalig nach der Erlaubnis) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Das Paket passkeys_android bringt CREDENTIAL_MANAGER_SET_ORIGIN mit. Das ist eine privilegierte Berechtigung (nur für
         Browser/System-Apps, die den Origin einer fremden Seite setzen); eine normale App bekommt sie nie, und der Paketcode
         setzt keinen Origin. Sie wird entfernt, damit die App nichts anfordert, was sie weder braucht noch bekommen kann.
         Passkeys der App (Origin android:apk-key-hash:...) sind davon nicht betroffen. Siehe deploy/README.md, Abschnitt 9. -->
    <uses-permission android:name="android.permission.CREDENTIAL_MANAGER_SET_ORIGIN" tools:node="remove" />
    <!-- Kamera nur für den QR-Scan der Einladung; ohne Kamera (z. B. Tablet ohne Rückkamera) bleibt die App installierbar.
         mobile_scanner trägt dieselbe Angabe ein; sie steht hier ausdrücklich, damit sie nicht von einem Plugin-Update abhängt. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- Lokale Terminerinnerungen (Plugin flutter_local_notifications; alles bleibt auf dem Gerät, kein Push-Dienst).
         POST_NOTIFICATIONS: Laufzeit-Abfrage ab Android 13, nur auf Wunsch in Profil, Erinnerungen (nicht beim ersten Start).
         RECEIVE_BOOT_COMPLETED: das Plugin setzt die Alarme nach einem Neustart neu.
         USE_EXACT_ALARM: genaue Alarme für Kalender-Erinnerungen ohne Nachfrage (Kalender-App, Verteilung außerhalb eines Stores);
         fehlt die Erlaubnis, plant die App ungenau. Das Plugin trägt POST_NOTIFICATIONS und VIBRATE ebenfalls ein (Merge-Bericht prüfen). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Android 12 und 12L (API 31 und 32) kennen USE_EXACT_ALARM noch nicht: dort gilt die ältere Erlaubnis, die damals ohne Nachfrage erteilt wird -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- Push (UnifiedPush, ntfy-App als Verteiler): unifiedpush_android bringt über die Bibliothek org.unifiedpush.android:connector selbst die
         Berechtigung WAKE_LOCK, die <queries> für Verteiler, den Empfänger MessagingReceiverImpl und den Dienst UnifiedPushService ins Manifest. Hier ist
         nichts einzutragen; nach dem Debug-Build den gemergten Manifest prüfen (docs/VERSIONEN.md, Zeile unifiedpush). -->
    <!-- Standort teilen (flüchtig, Ende-zu-Ende verschlüsselt, nur auf Tipp der Person, siehe docs/PROJEKTBESCHREIBUNG.md, 6f): Standort nur im Vordergrund
         (FINE und COARSE; ACCESS_BACKGROUND_LOCATION gibt es bewusst nicht), dazu ein Vordergrunddienst vom Typ "location" mit ständiger Benachrichtigung und
         eine Wecksperre, die der Dienst nur bis zur Ablaufzeit hält. Der Dienst wird nur aus der sichtbaren App gestartet. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Systemdialog "Im Hintergrund ohne Einschränkung ausführen?" (Akkuoptimierung nur für diese App, die Person bestätigt selbst); ohne das stoppt der Akkuschutz
         vieler Hersteller (One UI) das Teilen bei gesperrtem Bildschirm -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- GPS ist keine Voraussetzung für die Installation (Tablets, Netzwerk-Ortung genügt) -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Nur TLS: kein Klartext-Verkehr (familie.lx-labs.dev läuft hinter Caddy mit HTTPS) -->
    <application
        android:label="lx-familyhub"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">
        <!-- Ergebnis der Update-Installation (PackageInstaller); nur intern erreichbar -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />
        <!-- Startbildschirm-Widget "Heute" (HeuteWidget.kt): exportiert, weil Android es für Widget-Empfänger verlangt; reagiert nur auf Systemmeldungen
             (APPWIDGET_UPDATE und die geschützten Zeit-Meldungen, die nur das System senden kann) und liest nichts aus Intents. Tippen öffnet MainActivity
             über ein PendingIntent (FLAG_IMMUTABLE, ausdrückliches Ziel). Daten: app-privater Speicher, kein ContentProvider, keine Berechtigung. -->
        <receiver android:name=".HeuteWidget" android:exported="true" android:label="Heute">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/heute_widget_info" />
        </receiver>
        <!-- Terminerinnerungen: zeigt geplante Benachrichtigungen an und setzt sie nach Neustart/App-Update neu (nur intern erreichbar) -->
        <receiver android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" android:exported="false" />
        <receiver android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- Standort teilen: Vordergrunddienst, nur intern erreichbar; beendet sich selbst bei Ablauf, ohne Lebenszeichen der App und beim Wischen der App -->
        <service
            android:name=".StandortService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Flutters eigenes Deep-Linking aus: Einladungslinks verarbeitet die App selbst (Fragment mit Token) -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Einladungslinks: https://familie.lx-labs.dev/#/einladung/<token>. Android reicht das Fragment mit durch; die App liest
                 es (MainActivity.linkAus). autoVerify: Android prüft beim Installieren https://familie.lx-labs.dev/.well-known/assetlinks.json
                 und öffnet den Link bei Übereinstimmung direkt in der App, ohne Auswahldialog. Solange die Datei nicht (oder mit einem
                 anderen Fingerprint) ausgeliefert wird, schlägt die Prüfung still fehl: Der Link öffnet dann weiter im Browser bzw. mit
                 Nachfrage. Reihenfolge und Prüfung: deploy/README.md, Abschnitt 9. Host und Pfad stehen auch in MainActivity.kt
                 und in der Konstante kInviteHost (lib/constants.dart). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="familie.lx-labs.dev" android:path="/"/>
            </intent-filter>
            <!-- Teilen aus anderen Apps ("Teilen mit lx-familyhub"): nur Text (ACTION_SEND mit text/plain), keine Bilder, Dateien oder Mehrfachauswahl (kein
                 SEND_MULTIPLE, kein anderer MIME-Typ). MainActivity liest nur das String-Extra EXTRA_TEXT, kürzt es hart (4000 Zeichen) und gibt es an die Oberfläche,
                 die erst nach der Anmeldung fragt, wohin der Text soll (Liste, Aufgabe, verschlüsselter Chat). tools/release-pruefung.sh prüft die Form dieses Filters. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Nicht löschen: wird vom Flutter-Tool zur Erzeugung von GeneratedPluginRegistrant.java gebraucht -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
