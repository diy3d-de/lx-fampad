<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 und älter (android:fullBackupContent): nichts sichern. Die App hält Anmeldedaten im Android Keystore und
     lokale Daten in SQLite; beides gehört nie in ein Cloud- oder Geräte-Backup (der Keystore-Schlüssel würde bei der
     Wiederherstellung ohnehin fehlen und die Einträge unlesbar machen). allowBackup="false" gilt zusätzlich. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
