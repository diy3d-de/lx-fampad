{
  "name": "lx-fampad-server",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "description": "lx-fampad: API, Sync und WebSocket",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "node --env-file-if-exists=.env dist/db/migrate-cli.js",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint .",
    "test": "vitest run",
    "bootstrap": "node --env-file-if-exists=.env dist/cli/bootstrap.js",
    "weather-setup": "node --env-file-if-exists=.env dist/cli/weather-setup.js",
    "weather-poller": "node --env-file-if-exists=.env dist/cli/weather-poller.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@fastify/websocket": "11.3.3",
    "@simplewebauthn/server": "14.0.3",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "otplib": "13.5.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
