# systemd-Dienst für die lx-fampad API (Fastify, Port 4400 nur lokal).
# Installation: siehe deploy/README.md, Abschnitt "Dienst einrichten". Beide Einheiten gehören zusammen:
#   sudo cp deploy/lx-fampad.service deploy/lx-fampad-migrate.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now lx-fampad

[Unit]
Description=lx-fampad (lx-fampad API)
After=network.target postgresql.service lx-fampad-migrate.service
Wants=postgresql.service
# Migrationen laufen vor jedem Start in einer eigenen Einheit mit der Migrationsrolle (lx-fampad-migrate.service);
# der Dienst selbst läuft mit der Laufzeitrolle (nur DML) und kennt die Zugangsdaten der Migrationsrolle nicht.
Requires=lx-fampad-migrate.service

[Service]
Type=simple
User=lx-fampad
Group=lx-fampad
WorkingDirectory=/srv/fampad/server
Environment=NODE_ENV=production
# Fest eingetragen (nicht in der env-Datei): Caddy (deploy/Caddyfile) und deploy.sh gehen von diesem Port aus,
# und der Health-Check in deploy.sh braucht ihn, ohne die Geheimnisse der env-Datei lesen zu müssen.
Environment=HOST=127.0.0.1
Environment=PORT=4400
# Der Heap muss unter MemoryMax bleiben (ProcSubset=pid blendet /proc/meminfo aus, V8 kann den Speicher nicht selbst erkennen)
Environment=NODE_OPTIONS=--max-old-space-size=384
# DATABASE_URL, PUBLIC_URL usw. stehen in dieser Datei: root:root, 0600. systemd liest sie als root, bevor es auf
# den Benutzer lx-fampad wechselt; der Dienst und alle anderen Benutzer (auch lx) können sie nicht lesen. Vorlage: server/.env.example
EnvironmentFile=/etc/lx-fampad/env
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=5

# Ressourcengrenzen (der VPS teilt sich den Speicher mit lx-labs, PostgreSQL und Caddy)
MemoryMax=512M
TasksMax=256
LimitNOFILE=4096

# Härtung
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# fremde Prozesse nicht sehen; /proc nur mit Prozess-Verzeichnissen (kein /proc/meminfo, /proc/cpuinfo)
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallArchitectures=native
# Systemaufrufe: normale Dienst-Aufrufe erlauben, privilegierte und Ressourcen-Aufrufe sperren.
# Kein MemoryDenyWriteExecute: V8 (JIT) braucht beschreibbaren, ausführbaren Speicher.
# Gesperrte Aufrufe liefern einen Fehler (EPERM) statt den Dienst zu beenden.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
# Neue Dateien nur für den Dienst lesbar
UMask=0077
# Schreibzugriff nur auf die Dateiablage
ReadWritePaths=/srv/fampad/files

[Install]
WantedBy=multi-user.target
